# Copy this file to .env for local development (XAMPP / Docker).
# On Azure set the same names in: App Service → Settings → Environment variables.
# NEVER commit the real .env.

APP_ENV=development

DB_HOST=localhost
DB_NAME=knowledgebase
DB_USER=root
DB_PASS=
DB_SSL=0

# Azure only
# TRUST_PROXY=1
# UPLOAD_DIR=/home/data/uploads

# Email codes (Brevo) — optional locally: without them the code is shown on screen in development
# MAIL_API_KEY=
# MAIL_FROM=
# MAIL_FROM_NAME=Knowledge

# Cloudflare Turnstile — optional
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
